# ========================================================
# Atiende - Variables de entorno
# ========================================================

# URL base de la aplicación (sin barra final)
APP_URL="http://localhost:3000"

# Administrador inicial creado al arrancar si no existe
ADMIN_EMAIL="admin@atiende.local"
ADMIN_PASSWORD="AdminPassword2026!"

# Clave secreta para cifrar tokens de integraciones (AES-256-GCM, 32 bytes en hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Clave secreta para la sesión de usuario (JWT)
AUTH_SECRET="atiende-auth-secret-change-me-in-production-2026"

# Inteligencia Artificial (OpenRouter API)
OPENROUTER_API_KEY=""

# WhatsApp con Baileys
WHATSAPP_SESSION_DIR="./.whatsapp_auth"

# Base de datos PostgreSQL
# En local usa PGlite o conexión postgres estándar:
DATABASE_URL="postgresql://atiende:atiende@localhost:5432/atiende_db?schema=public"

# Cargar automáticamente los datos de prueba de la «Clínica Dental Lumen»
SEED_DEMO="true"
