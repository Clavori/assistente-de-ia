# ========================================================
# Atende AI — Plataforma de Assistente de IA para Negócios
# ========================================================

# URL base da aplicação web (sem barra final)
APP_URL="http://localhost:3000"

# Credenciais do Administrador inicial (criado automaticamente ao inicializar)
ADMIN_EMAIL="admin@atiende.local"
ADMIN_PASSWORD="AdminPassword2026!"

# Chave secreta para criptografia AES-256-GCM dos tokens e senhas de integrações
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Chave secreta para assinatura das sessões JWT
AUTH_SECRET="atiende-auth-secret-change-me-in-production-2026"

# Chave de API da OpenRouter (obtenha em https://openrouter.ai/keys)
# Modelo padrão utilizado: anthropic/claude-haiku-5.5 (com suporte nativo a Tool Calling)
OPENROUTER_API_KEY=""

# Diretório de persistência da sessão do WhatsApp (Baileys)
WHATSAPP_SESSION_DIR="./.whatsapp_auth"

# Banco de dados PostgreSQL (compatível com Prisma Dev local ou PostgreSQL de produção / Docker)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true"

# Carga de dados iniciais de demonstração (Andrade Studio AI: sites, apps e automações com IA)
SEED_DEMO="true"
