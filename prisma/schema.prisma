generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin, member
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id               String   @id @default(cuid())
  name             String   @default("AndradeStudio")
  activity         String   @default("Sites, Aplicativos, Automações com IA e Vídeos para Empresas")
  address          String?  @default("São Paulo - SP • Atendimento em todo o Brasil")
  phone            String   @default("+55 11 98765-4321")
  website          String?  @default("https://andrade-studio.vercel.app")
  hoursConfig      Json?    // Horario por dias da semana
  afterHoursAction String   @default("continue_booking") // continue_booking | take_message
  agencyName       String   @default("AndradeStudio")
  agencyLogo       String?  @default("/assets/logo.png")
  timeZone         String   @default("America/Sao_Paulo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AssistantConfig {
  id               String   @id @default(cuid())
  name             String   @default("Andrade AI")
  avatar           String?  @default("/assets/logo.png")
  tone             String   @default("cercano") // cercano, profissional, direto
  welcomeMessage   String   @default("Olá! Seja bem-vindo à AndradeStudio 🚀 Sou o assistente virtual especializado em sites premium, apps e automações com IA.")
  instructions     String
  neverDoRules     Json?    // Array de coisas que nunca deve fazer
  escalateTriggers Json?    // { complaint: true, urgent: true, asksHuman: true, unknownAnswer: true, customRule: "" }
  active           Boolean  @default(true) // Interruptor geral: Assistente ativo / pausado
  modelSelected    String   @default("anthropic/claude-haiku-5.5")
  safeMode         Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int      @default(30)
  price           Decimal?
  priceFrom       Boolean  @default(false) // "a partir de"
  requiresTriage  Boolean  @default(false) // "requer avaliação prévia"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeNote {
  id        String   @id @default(cuid())
  title     String   @default("Informações adicionais")
  content   String
  updatedAt DateTime @updatedAt
}

model Integration {
  id             String    @id @default(cuid())
  provider       String    @unique // google_calendar, gmail, google_sheets, slack, stripe, webhooks
  status         String    @default("disconnected") // disconnected, connected, error
  accountEmail   String?
  encryptedData  String?   // AES-256-GCM tokens & secrets
  settings       Json?     // Configurações específicas
  allowedTools   Json?     // Array de ferramentas habilitadas para a IA
  errorMessage   String?
  lastSyncAt     DateTime?
  updatedAt      DateTime  @updatedAt
}

model Contact {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  whatsappLid   String?
  email         String?
  channel       String         @default("whatsapp") // whatsapp, web
  interest      String?
  notes         String?
  conversations Conversation[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Conversation {
  id            String    @id @default(cuid())
  channel       String    // whatsapp, web
  remoteId      String    // Número de telefone ou token de sessão web
  status        String    @default("bot_active") // bot_active, human_takeover, closed
  needsHuman    Boolean   @default(false)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // customer, assistant, agent
  text           String
  toolsUsed      Json?        // Registro de ferramentas chamadas neste turno
  createdAt      DateTime     @default(now())
}

model Appointment {
  id                    String   @id @default(cuid())
  contactId             String
  contact               Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceName           String
  startsAt              DateTime
  endsAt                DateTime
  status                String   @default("confirmed") // confirmed, cancelled
  googleCalendarEventId String?
  reminderSent          Boolean  @default(false)
  createdByAssistant    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  channel     String   // whatsapp, web, system
  integration String?  // google_calendar, gmail, etc.
  action      String   // tool_call, error, appointment_created, handover
  details     Json?
  result      String   @default("success") // success, error
  createdAt   DateTime @default(now())
}

model WhatsAppConnection {
  id              String    @id @default("default")
  status          String    @default("disconnected") // disconnected, waiting_qr, connected, error
  qrCode          String?
  connectedNumber String?
  lastActiveAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

model WorkerCommand {
  id        String   @id @default(cuid())
  command   String   // start, stop, disconnect, restart
  payload   Json?
  status    String   @default("pending") // pending, executed, failed
  createdAt DateTime @default(now())
}

model WebChatConfig {
  id             String   @id @default("default")
  enabled        Boolean  @default(true)
  primaryColor   String   @default("#f20d16")
  welcomeMessage String   @default("Olá! Como posso ajudar seu projeto na AndradeStudio hoje?")
  botName        String   @default("Andrade AI")
  position       String   @default("bottom-right")
  updatedAt      DateTime @updatedAt
}
